# 届いた改善要望を、この作業ディレクトリから読み出すための設定の見本。
#
# 使うときは、このファイルを .env.local という名前で写してから、鍵を書き足します。
#   cp env.example .env.local
# .env.local は共有されません（除外済み）。鍵をこの見本ファイル自体に
# 書かないでください（見本のほうは共有されます）。
#
# 使い方:
#   pnpm improvements list          手つかずの改善要望を一覧で見る
#   pnpm improvements get <要望ID>  作業指示文を読む
# Claude Code からは /improvements と /improve-request <要望ID> でも呼べます。

# 改善要望を読むための鍵。
# 本番の画面 https://hr-evaluation-system.daishimanju.workers.dev/system/agent-keys を
# システム全体管理者で開き、用途の名前を付けて「鍵を発行する」を押すと作られます。
# 鍵はその場で1回だけ表示されます。控えて、次の行に貼ってください。
HR_AGENT_KEY=

# 1Password に鍵を入れて使うときは、この行に「場所」だけを書きます。
# 鍵そのものはこのファイルにも .env.local にも書かなくて済みます。
# HR_AGENT_KEY_OP_REF=op://保管庫/項目名/credential

# 要望を取りにいく先。書かなければ本番を見にいきます。
# ローカルで確かめるときだけ、次の行のコメントを外して使います。
# HR_APP_URL=http://localhost:8787
