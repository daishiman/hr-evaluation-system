  "sharedOperations": [
    {
      "id": "formExtensions.manage",
      "label": "回答の締め切りを延ばす",
      "minRole": "MANAGER",
      "actions": [
        "actions/form-extensions.ts#grantFormExtension",
        "actions/form-extensions.ts#revokeFormExtension"
      ],
      "description": "締め切りを過ぎた人に、回答できる期間を個別に延ばす・取り消す。"
    },
    {
      "id": "credentialMemos.reveal",
      "label": "初期パスワードの控えを見る",
      "minRole": "COMPANY_ADMIN",
      "actions": [
        "actions/credential-memos.ts#revealCredentialMemo"
      ],
      "description": "登録したときの初期パスワードの控えを表示する。全体管理者は会社をまたいで見られる。"
    },
    {
      "id": "improvements.submit",
      "label": "改善要望を送る",
      "minRole": "EMPLOYEE",
      "actions": [
        "actions/improvements.ts#submitImprovement",
        "api/improvements#POST"
      ],
      "description": "どの画面からでも「ここが使いにくい」を送る。"
    },
    {
      "id": "usage.record",
      "label": "画面の利用を記録する",
      "minRole": "EMPLOYEE",
      "actions": [
        "api/usage#POST"
      ],
      "description": "どの画面をどれだけ使ったかを記録する（利用状況の集計に使う）。"
    },
    {
      "id": "companyScope.switch",
      "label": "操作する会社を選ぶ",
      "minRole": "EMPLOYEE",
      "actions": [
        "actions/company-scope.ts#switchCompanyScope"
      ],
      "description": "どの会社の画面を操作するかを選ぶ。全体管理者は有効な会社ならどこでも、ほかの役割は自分が所属している会社だけ。"
    },
    {
      "id": "search.run",
      "label": "画面を検索する",
      "minRole": "EMPLOYEE",
      "actions": [
        "api/search#GET"
      ],
      "description": "ヘッダーの検索から、画面と人を探す。探せる人の範囲は役割で決まる。"
    },
    {
      "id": "search.people",
      "label": "人を検索する",
      "minRole": "MANAGER",
      "actions": [],
      "description": "検索で人を探す。一般の方は他の人の一覧を見られないので、人は探せない。"
    },
    {
      "id": "appearance.save",
      "label": "画面の外観を保存する",
      "minRole": "EMPLOYEE",
      "actions": [
        "api/theme-choice#PUT"
      ],
      "description": "明るさと配色の選択を、自分の設定として保存する。"
    },
    {
      "id": "appearance.read",
      "label": "外観の選択を集計する",
      "minRole": "SUPER_ADMIN",
      "actions": [
        "api/theme-choice#GET"
      ],
      "description": "利用者が選んだ明るさと配色の内訳を見る。"
    }
  ],
