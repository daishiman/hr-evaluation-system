{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hr-evaluation-system",
  "main": ".open-next/worker.js",
  // ローカル実行用のランタイム（workerd）が対応している最新日付に合わせる
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // 公開アドレス。ログインの折り返し先に使う（秘密の値ではない）
  "vars": { "BETTER_AUTH_URL": "https://hr-evaluation-system.daishimanju.workers.dev" },
  // 版ごとの下見用URLは作らない（本番と同じデータに別の入口を増やさないため）
  "preview_urls": false,
  "upload_source_maps": true,
  // 未設定のままデプロイして「本番だけ動かない」を防ぐ
  "secrets": { "required": ["BETTER_AUTH_SECRET"] },
  // 費用の安全弁（limits.cpu_ms）は有料プランのみ設定できるため、
  // 無料プランで動かしている間は指定しない。有料化したら次を有効にする。
  // "limits": { "cpu_ms": 30000 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hr-evaluation-db",
      "database_id": "58242d06-2eeb-419f-b6bf-9d8340f25593",
      "migrations_dir": "drizzle/migrations"
    }
  ]
}
