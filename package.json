{
  "name": "hr-evaluation-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --port 8787",
    "cf:dry-run": "opennextjs-cloudflare build",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:worker": "opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply hr-evaluation-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply hr-evaluation-db --remote",
    "db:seed:local": "node scripts/seed.mjs --local",
    "db:seed:remote": "node scripts/seed.mjs --remote",
    "db:sample:local": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/seed-sample.mjs",
    "db:sample:remote": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/seed-sample.mjs --remote",
    "db:sample:remove:local": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/seed-sample.mjs --remove",
    "db:sample:remove:remote": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/seed-sample.mjs --remove --remote",
    "db:backup": "wrangler d1 export hr-evaluation-db --remote --output=backup.sql",
    "user:add": "node scripts/add-user.mjs",
    "db:seed:reference": "node scripts/seed-reference-points.mjs"
  },
  "dependencies": {
    "better-auth": "^1.6.26",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
