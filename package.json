{
  "name": "hr-evaluation-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --port 8787",
    "cf:dry-run": "opennextjs-cloudflare build",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:docs": "node scripts/check-docs-drift.mjs",
    "check:security": "node scripts/check-security-patterns.mjs",
    "smoke:auth": "node scripts/smoke-authenticated.mjs",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:worker": "opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply hr-evaluation-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply hr-evaluation-db --remote",
    "db:seed:local": "node scripts/seed.mjs --local",
    "db:sample:local": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/seed-sample.mjs",
    "db:sample:remote": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/seed-sample.mjs --remote",
    "db:sample:remove:local": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/seed-sample.mjs --remove",
    "db:sample:remove:remote": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/seed-sample.mjs --remove --remote",
    "improvements": "node scripts/improvements.mjs",
    "user:add": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/add-user.mjs",
    "credential:rewrap": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/rewrap-credential-vault.mjs",
    "db:seed:reference": "node scripts/seed-reference-points.mjs"
  },
  "dependencies": {
    "better-auth": "^1.6.26",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.31.0",
    "modern-screenshot": "^4.7.0",
    "next": "^16.4.2",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.2.4",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.3"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=2.0.0 <2.1.6": "2.1.6",
      "brace-expansion@>=5.0.0 <5.0.11": "5.0.11",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "proxy-addr@>=1.1.0 <2.0.8": "2.0.8",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2"
    }
  }
}
